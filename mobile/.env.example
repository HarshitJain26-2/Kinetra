# Kinetra Mobile Environment Configuration (Expo Public Variables)
# NOTE: Only Anon/Public client credentials are permitted here.
# NEVER place SUPABASE_SERVICE_ROLE_KEY in the mobile codebase.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Use your development PC LAN IP (e.g. http://192.168.x.x:5000/api/v1) for physical device testing
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
